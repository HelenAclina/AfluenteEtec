            <com.google.android.material.card.MaterialCardView android:id="@+id/cardMetas" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/cardGrafico" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

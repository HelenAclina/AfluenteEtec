            <com.google.android.material.card.MaterialCardView android:id="@+id/cardAlertaConsumo" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" android:visibility="gone" app:cardBackgroundColor="@color/alert_red_background" app:strokeColor="@color/alert_red_border" app:layout_constraintTop_toBottomOf="@id/headerDashboard" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

                    <FrameLayout android:id="@+id/avatarDashboard" android:layout_width="48dp" android:layout_height="48dp" android:clickable="true" android:focusable="true" android:contentDescription="Abrir perfil">
                        <TextView android:id="@+id/tvAvatarDashboard" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:background="@drawable/profile_avatar" android:text="?" android:textStyle="bold" android:textColor="@android:color/white" android:importantForAccessibility="no" />
                        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/imgFotoDashboard" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:scaleType="centerCrop" android:visibility="gone" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/Afluente.AvatarCircular" />

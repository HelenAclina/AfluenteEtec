                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dashboard_goals" android:textColor="@color/onboarding_text" android:textStyle="bold" />
                        <TextView android:id="@+id/btnVerMetas" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingHorizontal="8dp" android:clickable="true" android:focusable="true" android:text="@string/dashboard_view_goals" android:textColor="@color/onboarding_blue" android:textStyle="bold" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dashboard_water" android:textColor="@color/onboarding_text" android:textSize="13sp" />
                        <TextView android:id="@+id/tvMetaAgua" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_no_goal" android:textColor="@color/onboarding_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressoMetaAgua" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:progress="0" app:trackThickness="7dp" app:trackCornerRadius="4dp" app:trackColor="@color/onboarding_border" app:indicatorColor="@color/water_accent" android:contentDescription="@string/dashboard_water_goal_unavailable" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dashboard_energy" android:textColor="@color/onboarding_text" android:textSize="13sp" />
                        <TextView android:id="@+id/tvMetaEnergia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_no_goal" android:textColor="@color/onboarding_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressoMetaEnergia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:progress="0" app:trackThickness="7dp" app:trackCornerRadius="4dp" app:trackColor="@color/onboarding_border" app:indicatorColor="@color/energy_accent" android:contentDescription="@string/dashboard_energy_goal_unavailable" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvAcessoRapido" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="20dp" android:text="@string/dashboard_quick_access" android:textColor="@color/onboarding_text" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/cardMetas" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <LinearLayout android:id="@+id/acessosRapidos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp" android:layout_marginBottom="84dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/tvAcessoRapido" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <com.google.android.material.card.MaterialCardView android:id="@+id/atalhoHistorico" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:contentDescription="@string/dashboard_history">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/dashboard_history" android:textColor="@color/onboarding_muted" android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/atalhoComparar" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:contentDescription="@string/dashboard_compare" android:layout_marginStart="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/dashboard_compare" android:textColor="@color/onboarding_muted" android:textSize="10sp" />
                    </LinearLayout>

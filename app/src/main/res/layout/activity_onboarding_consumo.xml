<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/onboarding_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <View android:id="@+id/header" android:layout_width="0dp" android:layout_height="150dp" android:background="@color/brand_deep_blue"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <ImageView android:id="@+id/logoMark" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="@dimen/screen_margin" android:src="@drawable/brand_mark" android:contentDescription="@string/brand_name" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/logo" app:layout_constraintBottom_toBottomOf="@id/logo" />
        <TextView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="1dp" android:layout_marginTop="32dp"
            android:text="@string/brand_wordmark" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/logoMark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="30dp" android:text="@string/step_three" style="@style/Afluente.Step"
            app:layout_constraintBaseline_toBaselineOf="@id/logo" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/progress" android:layout_width="0dp" android:layout_height="3dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="22dp" android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/logo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_inactive" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_inactive" android:layout_marginStart="5dp" />
        </LinearLayout>
        <TextView android:id="@+id/btnVoltar" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:layout_marginStart="12dp" android:paddingHorizontal="8dp" android:text="@string/back" android:textColor="@color/onboarding_step_text" android:textSize="14sp" android:clickable="true" android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/progress" app:layout_constraintStart_toStartOf="parent" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="8dp" android:text="@string/consumption_title" style="@style/Afluente.Title"
            app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="4dp" android:text="@string/consumption_subtitle" style="@style/Afluente.Subtitle"
            app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardAgua" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="16dp"

            app:layout_constraintTop_toBottomOf="@id/subtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:id="@+id/iconAgua" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/onboarding_icon_background" android:backgroundTint="@color/water_background" android:text="💧" android:textSize="19sp" android:importantForAccessibility="no" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
                <TextView android:id="@+id/labelAgua" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/water" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="13sp" app:layout_constraintTop_toTopOf="@id/iconAgua" app:layout_constraintStart_toEndOf="@id/iconAgua" app:layout_constraintEnd_toEndOf="parent" />
                <TextView android:id="@+id/subAgua" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/monthly_average" android:textColor="@color/onboarding_muted" android:textSize="10sp" app:layout_constraintTop_toBottomOf="@id/labelAgua" app:layout_constraintStart_toEndOf="@id/iconAgua" app:layout_constraintEnd_toEndOf="parent" />
                <androidx.constraintlayout.widget.Barrier android:id="@+id/barreiraAgua" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="iconAgua,subAgua" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputAgua" style="@style/Afluente.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/water_hint" app:layout_constraintTop_toBottomOf="@id/barreiraAgua" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/unitAgua">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConsumoAgua" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="numberDecimal" android:digits="0123456789.," android:textSize="13sp" android:singleLine="true" android:contentDescription="@string/water" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/unitAgua" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/water_unit" android:textColor="@color/onboarding_muted" android:textStyle="bold" android:textSize="12sp" app:layout_constraintStart_toEndOf="@id/inputAgua" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/inputAgua" app:layout_constraintBottom_toBottomOf="@id/inputAgua" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardEnergia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="16dp"

            app:layout_constraintTop_toBottomOf="@id/cardAgua" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:id="@+id/iconEnergia" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/onboarding_icon_background" android:backgroundTint="@color/energy_background" android:text="⚡" android:textSize="19sp" android:importantForAccessibility="no" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
                <TextView android:id="@+id/labelEnergia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/energy" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="13sp" app:layout_constraintTop_toTopOf="@id/iconEnergia" app:layout_constraintStart_toEndOf="@id/iconEnergia" app:layout_constraintEnd_toEndOf="parent" />
                <TextView android:id="@+id/subEnergia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/monthly_average" android:textColor="@color/onboarding_muted" android:textSize="10sp" app:layout_constraintTop_toBottomOf="@id/labelEnergia" app:layout_constraintStart_toEndOf="@id/iconEnergia" app:layout_constraintEnd_toEndOf="parent" />
                <androidx.constraintlayout.widget.Barrier android:id="@+id/barreiraEnergia" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="iconEnergia,subEnergia" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputEnergia" style="@style/Afluente.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/energy_hint" app:layout_constraintTop_toBottomOf="@id/barreiraEnergia" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/unitEnergia">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConsumoEnergia" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="numberDecimal" android:digits="0123456789.," android:textSize="13sp" android:singleLine="true" android:contentDescription="@string/energy" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/unitEnergia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/energy_unit" android:textColor="@color/onboarding_muted" android:textStyle="bold" android:textSize="12sp" app:layout_constraintStart_toEndOf="@id/inputEnergia" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/inputEnergia" app:layout_constraintBottom_toBottomOf="@id/inputEnergia" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/unknownCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="30dp" android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardEnergia" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <CheckBox android:id="@+id/cbNaoSeiConsumo" android:layout_width="match_parent" android:layout_height="48dp" android:paddingStart="14dp" android:paddingEnd="10dp" android:text="@string/unknown_consumption" android:textColor="@color/onboarding_muted" android:textStyle="bold" android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton style="@style/Afluente.PrimaryButton" android:id="@+id/btnContinuar" android:layout_width="0dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="22dp" android:layout_marginBottom="30dp" android:text="@string/continue_label" app:layout_constraintTop_toBottomOf="@id/unknownCard" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

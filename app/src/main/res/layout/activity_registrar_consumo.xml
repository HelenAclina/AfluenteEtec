<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/onboarding_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="24dp">
        <LinearLayout android:id="@+id/headerRegistro" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/brand_deep_blue" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="24dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <TextView android:id="@+id/btnVoltar" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:paddingEnd="20dp" android:text="@string/back" android:textColor="@color/onboarding_step_text" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tvTituloRegistro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/register_consumption" android:textStyle="bold" android:textSize="22sp" android:textColor="@android:color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/register_subtitle" android:textSize="14sp" android:textColor="@color/onboarding_step_text" />
            <TextView android:id="@+id/tvAvisoEdicao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ao alterar o tipo ou o valor, o custo será recalculado pela tarifa atual." android:textColor="@color/onboarding_step_text" android:textSize="12sp" android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleTipoRecurso" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="24dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/btnTabAgua" app:layout_constraintTop_toBottomOf="@id/headerRegistro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTabAgua" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/dashboard_water" android:textAllCaps="false" android:textColor="@color/consumption_toggle_text" app:backgroundTint="@color/consumption_toggle_background" app:strokeColor="@color/onboarding_border" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTabEnergia" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/dashboard_energy" android:textAllCaps="false" android:textColor="@color/consumption_toggle_text" app:backgroundTint="@color/consumption_toggle_background" app:strokeColor="@color/onboarding_border" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/labelData" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="20dp" android:text="@string/register_date" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/onboarding_muted" app:layout_constraintTop_toBottomOf="@id/toggleTipoRecurso" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputData" style="@style/Afluente.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="6dp" app:boxBackgroundColor="@color/surface" app:layout_constraintTop_toBottomOf="@id/labelData" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDataRegistro" android:layout_width="match_parent" android:layout_height="56dp" android:focusable="false" android:clickable="true" android:hint="@string/register_date_hint" android:contentDescription="@string/register_date_accessible" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/labelConsumo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="16dp" android:text="@string/register_water_label" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/onboarding_muted" app:layout_constraintTop_toBottomOf="@id/inputData" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputConsumo" style="@style/Afluente.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="6dp" app:boxBackgroundColor="@color/surface" app:suffixText="m³" app:layout_constraintTop_toBottomOf="@id/labelConsumo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etValorConsumo" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="numberDecimal" android:digits="0123456789.," android:hint="@string/register_water_hint" android:singleLine="true" android:contentDescription="@string/register_consumption_value" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/labelObservacao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="16dp" android:text="@string/register_observation" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/onboarding_muted" app:layout_constraintTop_toBottomOf="@id/inputConsumo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputObservacao" style="@style/Afluente.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="6dp" app:boxBackgroundColor="@color/surface" app:layout_constraintTop_toBottomOf="@id/labelObservacao" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etObservacao" android:layout_width="match_parent" android:layout_height="96dp" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:hint="@string/register_observation_hint" android:maxLength="500" android:paddingTop="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSalvarRegistro" style="@style/Afluente.PrimaryButton" android:layout_width="0dp" android:layout_marginHorizontal="24dp" android:layout_marginTop="24dp" android:text="@string/register_save" app:layout_constraintTop_toBottomOf="@id/inputObservacao" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

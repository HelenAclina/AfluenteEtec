<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/onboarding_background" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <View android:id="@+id/header" android:layout_width="0dp" android:layout_height="150dp"
            android:background="@color/brand_deep_blue" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <ImageView android:id="@+id/logoMark" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="@dimen/screen_margin" android:src="@drawable/brand_mark" android:contentDescription="@string/brand_name" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/logo" app:layout_constraintBottom_toBottomOf="@id/logo" />
        <TextView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="1dp" android:layout_marginTop="32dp" android:text="@string/brand_wordmark"
            android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/header" app:layout_constraintStart_toEndOf="@id/logoMark" />
        <TextView android:id="@+id/step" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="30dp" android:text="@string/step_two" style="@style/Afluente.Step"
            app:layout_constraintBaseline_toBaselineOf="@id/logo" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/progress" android:layout_width="0dp" android:layout_height="3dp"
            android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="22dp" android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/logo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_inactive" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_inactive" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_inactive" android:layout_marginStart="5dp" />
        </LinearLayout>
        <TextView android:id="@+id/btnVoltar" android:layout_width="100dp" android:layout_height="48dp"
            android:gravity="center" android:text="@string/back" android:textColor="@color/onboarding_step_text" android:textSize="12sp"
            android:clickable="true" android:focusable="true" app:layout_constraintTop_toBottomOf="@id/progress"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="8dp" android:text="@string/residence_title"
            style="@style/Afluente.Title"
            app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/subtitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="4dp" android:text="@string/residence_subtitle"
            style="@style/Afluente.Subtitle"
            app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/residentsLabel" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="24dp" android:text="@string/residents_question"
            android:textColor="@color/onboarding_text" android:textSize="13sp" android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/subtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPessoa1" style="@style/ResidenceOption"
            android:layout_marginTop="9dp" android:text="@string/one_person"
            app:layout_constraintTop_toBottomOf="@id/residentsLabel" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="@dimen/screen_margin" app:layout_constraintEnd_toStartOf="@id/middle" android:layout_marginEnd="5dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPessoa2" style="@style/ResidenceOption"
            android:layout_marginTop="9dp" android:text="@string/two_people"
            app:layout_constraintTop_toBottomOf="@id/residentsLabel" app:layout_constraintStart_toEndOf="@id/middle" android:layout_marginStart="5dp" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="@dimen/screen_margin" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPessoa3" style="@style/ResidenceOption"
            android:layout_marginTop="9dp" android:text="@string/three_people"
            app:layout_constraintTop_toBottomOf="@id/btnPessoa1" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="@dimen/screen_margin" app:layout_constraintEnd_toStartOf="@id/middle" android:layout_marginEnd="5dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPessoa4" style="@style/ResidenceOption"
            android:layout_marginTop="9dp" android:text="@string/four_people"
            app:layout_constraintTop_toBottomOf="@id/btnPessoa1" app:layout_constraintStart_toEndOf="@id/middle" android:layout_marginStart="5dp" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="@dimen/screen_margin" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPessoa5" style="@style/ResidenceOption"
            android:layout_marginTop="9dp" android:text="@string/five_people"
            app:layout_constraintTop_toBottomOf="@id/btnPessoa3" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="@dimen/screen_margin" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="@dimen/screen_margin" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/middle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.5" />
        <TextView android:id="@+id/typeLabel" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="24dp" android:text="@string/residence_question"
            android:textColor="@color/onboarding_text" android:textSize="13sp" android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnPessoa5" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/typeCards" android:layout_width="0dp" android:layout_height="82dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="10dp" android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/typeLabel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCasa" style="@style/ResidenceCard" android:layout_weight="1" android:contentDescription="@string/house">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_casa" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/house" android:textSize="11sp" android:textColor="@color/onboarding_muted" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardApartamento" style="@style/ResidenceCard" android:layout_weight="1" android:contentDescription="@string/apartment" android:layout_marginStart="9dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_apartamento" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/apartment" android:textSize="11sp" android:textColor="@color/onboarding_muted" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardOutro" style="@style/ResidenceCard" android:layout_weight="1" android:contentDescription="@string/other" android:layout_marginStart="9dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_outro" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/other" android:textSize="11sp" android:textColor="@color/onboarding_muted" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton style="@style/Afluente.PrimaryButton" android:id="@+id/btnContinuar" android:layout_width="0dp"
            android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="24dp" android:layout_marginBottom="30dp"
            android:text="@string/continue_label"

            app:layout_constraintTop_toBottomOf="@id/typeCards" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

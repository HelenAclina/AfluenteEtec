<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/onboarding_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <View android:id="@+id/header" android:layout_width="0dp" android:layout_height="150dp" android:background="@color/brand_deep_blue"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <ImageView android:id="@+id/logoMark" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="@dimen/screen_margin" android:src="@drawable/brand_mark" android:contentDescription="@string/brand_name" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/logo" app:layout_constraintBottom_toBottomOf="@id/logo" />
        <TextView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="1dp" android:layout_marginTop="32dp"
            android:text="@string/brand_wordmark" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/logoMark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="30dp" android:text="@string/step_five" style="@style/Afluente.Step"
            app:layout_constraintBaseline_toBaselineOf="@id/logo" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/progress" android:layout_width="0dp" android:layout_height="3dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="22dp" android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/logo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
        </LinearLayout>
        <TextView android:id="@+id/btnVoltar" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:layout_marginStart="12dp" android:paddingHorizontal="8dp" android:text="@string/back" android:textColor="@color/onboarding_step_text" android:textSize="14sp" android:clickable="true" android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/progress" app:layout_constraintStart_toStartOf="parent" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="8dp" android:text="@string/tariffs_title" style="@style/Afluente.Title"
            app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="4dp" android:text="@string/tariffs_subtitle" style="@style/Afluente.Subtitle"
            app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardTarifaAgua" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/subtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:id="@+id/iconTarifaAgua" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@color/water_background" android:text="💧" android:textSize="19sp" android:importantForAccessibility="no" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
                <TextView android:id="@+id/labelTarifaAgua" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/water_tariff" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="13sp" app:layout_constraintTop_toTopOf="@id/iconTarifaAgua" app:layout_constraintStart_toEndOf="@id/iconTarifaAgua" app:layout_constraintEnd_toEndOf="parent" />
                <TextView android:id="@+id/subTarifaAgua" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/water_tariff_subtitle" android:textColor="@color/onboarding_muted" android:textSize="10sp" app:layout_constraintTop_toBottomOf="@id/labelTarifaAgua" app:layout_constraintStart_toEndOf="@id/iconTarifaAgua" app:layout_constraintEnd_toEndOf="parent" />
                <TextView android:id="@+id/prefixAgua" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/currency_prefix" android:textColor="@color/onboarding_muted" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/inputTarifaAgua" app:layout_constraintBottom_toBottomOf="@id/inputTarifaAgua" />
                <androidx.constraintlayout.widget.Barrier android:id="@+id/barreiraAgua" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="iconTarifaAgua,subTarifaAgua" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputTarifaAgua" style="@style/Afluente.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginStart="8dp" app:layout_constraintTop_toBottomOf="@id/barreiraAgua" app:layout_constraintStart_toEndOf="@id/prefixAgua" app:layout_constraintEnd_toStartOf="@id/unitTarifaAgua">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTarifaAgua" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="numberDecimal" android:digits="0123456789.," android:textSize="13sp" android:singleLine="true" android:contentDescription="@string/water_tariff" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/unitTarifaAgua" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/water_tariff_unit" android:textColor="@color/onboarding_muted" android:textStyle="bold" android:textSize="12sp" app:layout_constraintStart_toEndOf="@id/inputTarifaAgua" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/inputTarifaAgua" app:layout_constraintBottom_toBottomOf="@id/inputTarifaAgua" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardTarifaEnergia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/cardTarifaAgua" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
                <TextView android:id="@+id/iconTarifaEnergia" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@color/energy_background" android:text="⚡" android:textSize="19sp" android:importantForAccessibility="no" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
                <TextView android:id="@+id/labelTarifaEnergia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/energy_tariff" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="13sp" app:layout_constraintTop_toTopOf="@id/iconTarifaEnergia" app:layout_constraintStart_toEndOf="@id/iconTarifaEnergia" app:layout_constraintEnd_toEndOf="parent" />
                <TextView android:id="@+id/subTarifaEnergia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/energy_tariff_subtitle" android:textColor="@color/onboarding_muted" android:textSize="10sp" app:layout_constraintTop_toBottomOf="@id/labelTarifaEnergia" app:layout_constraintStart_toEndOf="@id/iconTarifaEnergia" app:layout_constraintEnd_toEndOf="parent" />
                <TextView android:id="@+id/prefixEnergia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/currency_prefix" android:textColor="@color/onboarding_muted" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/inputTarifaEnergia" app:layout_constraintBottom_toBottomOf="@id/inputTarifaEnergia" />
                <androidx.constraintlayout.widget.Barrier android:id="@+id/barreiraEnergia" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="iconTarifaEnergia,subTarifaEnergia" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputTarifaEnergia" style="@style/Afluente.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginStart="8dp" app:layout_constraintTop_toBottomOf="@id/barreiraEnergia" app:layout_constraintStart_toEndOf="@id/prefixEnergia" app:layout_constraintEnd_toStartOf="@id/unitTarifaEnergia">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTarifaEnergia" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="numberDecimal" android:digits="0123456789.," android:textSize="13sp" android:singleLine="true" android:contentDescription="@string/energy_tariff" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/unitTarifaEnergia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/energy_tariff_unit" android:textColor="@color/onboarding_muted" android:textStyle="bold" android:textSize="12sp" app:layout_constraintStart_toEndOf="@id/inputTarifaEnergia" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/inputTarifaEnergia" app:layout_constraintBottom_toBottomOf="@id/inputTarifaEnergia" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/infoTarifas" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="16dp" android:padding="14dp" android:background="@color/onboarding_selected" android:text="@string/tariffs_info" android:textColor="#5684C3" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/cardTarifaEnergia" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.button.MaterialButton style="@style/Afluente.PrimaryButton" android:id="@+id/btnConcluirConfiguracao" android:layout_width="0dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="12dp" android:text="@string/finish_configuration" app:layout_constraintTop_toBottomOf="@id/infoTarifas" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/tvPularConfiguracao" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginBottom="20dp" android:gravity="center" android:text="@string/skip_configuration" android:textColor="@color/onboarding_muted" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true" app:layout_constraintTop_toBottomOf="@id/btnConcluirConfiguracao" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/onboarding_background">
    <LinearLayout android:id="@+id/cabecalhoRelatorios" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/brand_deep_blue" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="28dp" android:paddingBottom="20dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Relatórios" android:textSize="22sp" android:textColor="@android:color/white" android:textStyle="bold" />
        <!-- Abas Mensal / Anual no mesmo estilo das abas Água / Energia (realce aplicado no código) -->
        <LinearLayout android:id="@+id/abasRelatorio" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/segment_container" android:orientation="horizontal" android:padding="4dp">
            <TextView android:id="@+id/tabMensal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Mensal" android:textSize="15sp" android:textStyle="bold" android:focusable="true" android:clickable="true" android:contentDescription="Relatório mensal" />
            <TextView android:id="@+id/tabAnual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Anual" android:textSize="15sp" android:textStyle="bold" android:focusable="true" android:clickable="true" android:contentDescription="Relatório anual" />
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/scrollRelatorios" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/cabecalhoRelatorios" app:layout_constraintBottom_toTopOf="@id/bottomNavigation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/tvPeriodoRelatorio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Últimos 6 meses" android:textColor="@color/onboarding_muted" android:textSize="12sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <LinearLayout android:id="@+id/gridPicos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" app:layout_constraintTop_toBottomOf="@id/tvPeriodoRelatorio" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Maior consumo de água" android:textColor="@color/onboarding_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvMaiorAguaValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="16sp" />
                            <TextView android:id="@+id/tvMaiorAguaMes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sem dados" android:textColor="@color/onboarding_muted" android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Menor consumo de água" android:textColor="@color/onboarding_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvMenorAguaValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="16sp" />
                            <TextView android:id="@+id/tvMenorAguaMes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sem dados" android:textColor="@color/onboarding_muted" android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Maior consumo de energia" android:textColor="@color/onboarding_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvMaiorEnergiaValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="16sp" />
                            <TextView android:id="@+id/tvMaiorEnergiaMes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sem dados" android:textColor="@color/onboarding_muted" android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:orientation="vertical" android:padding="12dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Menor consumo de energia" android:textColor="@color/onboarding_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvMenorEnergiaValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="16sp" />
                            <TextView android:id="@+id/tvMenorEnergiaMes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sem dados" android:textColor="@color/onboarding_muted" android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardLinha" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/gridPicos" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvTituloGraficoAgua" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Consumo de água (m³)" android:textColor="@color/onboarding_text" android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart android:id="@+id/lineChartConsumoAgua" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardLinhaEnergia" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/cardLinha" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvTituloGraficoEnergia" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Consumo de energia (kWh)" android:textColor="@color/onboarding_text" android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart android:id="@+id/lineChartConsumoEnergia" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardBarras" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/cardLinhaEnergia" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvTituloGraficoGastos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gastos totais por mês (R$)" android:textColor="@color/onboarding_text" android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.BarChart android:id="@+id/barChartGastosTotais" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="8dp" />
                    <TextView android:id="@+id/tvAvisoCustos" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/onboarding_muted" android:textSize="11sp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardResumoPeriodo" style="@style/Afluente.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/cardBarras" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Resumo do período" android:textColor="@color/onboarding_text" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total água consumida" android:textColor="@color/onboarding_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvTotalAguaPeriodo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="—" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total energia consumida" android:textColor="@color/onboarding_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvTotalEnergiaPeriodo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="—" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gasto total estimado" android:textColor="@color/onboarding_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvGastoTotalPeriodo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="—" android:textColor="@color/onboarding_text" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnExportar" style="@style/Afluente.PrimaryButton" android:layout_width="0dp" android:layout_marginTop="16dp" android:text="Exportar CSV" app:layout_constraintTop_toBottomOf="@id/cardResumoPeriodo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/surface" app:menu="@menu/dashboard_navigation" app:labelVisibilityMode="labeled" app:itemHorizontalTranslationEnabled="false" app:itemIconTint="@color/dashboard_navigation_tint" app:itemTextColor="@color/dashboard_navigation_tint" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

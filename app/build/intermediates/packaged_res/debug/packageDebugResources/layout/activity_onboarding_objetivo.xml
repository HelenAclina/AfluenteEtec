<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/onboarding_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <View android:id="@+id/header" android:layout_width="0dp" android:layout_height="150dp" android:background="@color/brand_deep_blue" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <ImageView android:id="@+id/logoMark" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="@dimen/screen_margin" android:src="@drawable/brand_mark" android:contentDescription="@string/brand_name" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/logo" app:layout_constraintBottom_toBottomOf="@id/logo" />
        <TextView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="1dp" android:layout_marginTop="32dp" android:text="@string/brand_wordmark" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/logoMark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="30dp" android:text="@string/step_four" style="@style/Afluente.Step" app:layout_constraintBaseline_toBaselineOf="@id/logo" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/progress" android:layout_width="0dp" android:layout_height="3dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="22dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/logo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_active" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@drawable/progress_inactive" android:layout_marginStart="5dp" />
        </LinearLayout>
        <TextView android:id="@+id/btnVoltar" android:layout_width="100dp" android:layout_height="48dp" android:gravity="center" android:text="@string/back" android:textColor="@color/onboarding_step_text" android:textSize="12sp" android:clickable="true" android:focusable="true" app:layout_constraintTop_toBottomOf="@id/progress" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="8dp" android:text="@string/objectives_title" style="@style/Afluente.Title" app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="4dp" android:text="@string/objectives_subtitle" style="@style/Afluente.Subtitle" app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardEconomizarDinheiro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="22dp" android:clickable="true" android:focusable="false" app:layout_constraintTop_toBottomOf="@id/subtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/iconEconomizarDinheiro" android:layout_width="42dp" android:layout_height="48dp" android:gravity="center" android:layout_marginStart="10dp" android:text="💰" android:textSize="20sp" android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <CheckBox android:id="@+id/cbEconomizarDinheiro" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="@color/onboarding_blue" android:contentDescription="@string/goal_money" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <TextView android:id="@+id/labelEconomizarDinheiro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/goal_money" android:textColor="@color/onboarding_text" android:textSize="13sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/iconEconomizarDinheiro" app:layout_constraintEnd_toStartOf="@id/cbEconomizarDinheiro" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/descEconomizarDinheiro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/goal_money_desc" android:textColor="@color/onboarding_muted" android:textSize="11sp" app:layout_constraintStart_toStartOf="@id/labelEconomizarDinheiro" app:layout_constraintEnd_toEndOf="@id/labelEconomizarDinheiro" app:layout_constraintTop_toBottomOf="@id/labelEconomizarDinheiro" app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardReduzirConsumo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="10dp" android:clickable="true" android:focusable="false" app:layout_constraintTop_toBottomOf="@id/cardEconomizarDinheiro" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/iconReduzirConsumo" android:layout_width="42dp" android:layout_height="48dp" android:gravity="center" android:layout_marginStart="10dp" android:text="📉" android:textSize="20sp" android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <CheckBox android:id="@+id/cbReduzirConsumo" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="@color/onboarding_blue" android:contentDescription="@string/goal_consumption" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <TextView android:id="@+id/labelReduzirConsumo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/goal_consumption" android:textColor="@color/onboarding_text" android:textSize="13sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/iconReduzirConsumo" app:layout_constraintEnd_toStartOf="@id/cbReduzirConsumo" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/descReduzirConsumo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/goal_consumption_desc" android:textColor="@color/onboarding_muted" android:textSize="11sp" app:layout_constraintStart_toStartOf="@id/labelReduzirConsumo" app:layout_constraintEnd_toEndOf="@id/labelReduzirConsumo" app:layout_constraintTop_toBottomOf="@id/labelReduzirConsumo" app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardEvitarDesperdicios" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="10dp" android:clickable="true" android:focusable="false" app:layout_constraintTop_toBottomOf="@id/cardReduzirConsumo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/iconEvitarDesperdicios" android:layout_width="42dp" android:layout_height="48dp" android:gravity="center" android:layout_marginStart="10dp" android:text="♻️" android:textSize="20sp" android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <CheckBox android:id="@+id/cbEvitarDesperdicios" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="@color/onboarding_blue" android:contentDescription="@string/goal_waste" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <TextView android:id="@+id/labelEvitarDesperdicios" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/goal_waste" android:textColor="@color/onboarding_text" android:textSize="13sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/iconEvitarDesperdicios" app:layout_constraintEnd_toStartOf="@id/cbEvitarDesperdicios" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/descEvitarDesperdicios" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/goal_waste_desc" android:textColor="@color/onboarding_muted" android:textSize="11sp" app:layout_constraintStart_toStartOf="@id/labelEvitarDesperdicios" app:layout_constraintEnd_toEndOf="@id/labelEvitarDesperdicios" app:layout_constraintTop_toBottomOf="@id/labelEvitarDesperdicios" app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Afluente.Card" android:id="@+id/cardHabitosSustentaveis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="10dp" android:clickable="true" android:focusable="false" app:layout_constraintTop_toBottomOf="@id/cardEvitarDesperdicios" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/iconHabitosSustentaveis" android:layout_width="42dp" android:layout_height="48dp" android:gravity="center" android:layout_marginStart="10dp" android:text="🌱" android:textSize="20sp" android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <CheckBox android:id="@+id/cbHabitosSustentaveis" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="@color/onboarding_blue" android:contentDescription="@string/goal_habits" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <TextView android:id="@+id/labelHabitosSustentaveis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/goal_habits" android:textColor="@color/onboarding_text" android:textSize="13sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/iconHabitosSustentaveis" app:layout_constraintEnd_toStartOf="@id/cbHabitosSustentaveis" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/descHabitosSustentaveis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/goal_habits_desc" android:textColor="@color/onboarding_muted" android:textSize="11sp" app:layout_constraintStart_toStartOf="@id/labelHabitosSustentaveis" app:layout_constraintEnd_toEndOf="@id/labelHabitosSustentaveis" app:layout_constraintTop_toBottomOf="@id/labelHabitosSustentaveis" app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton style="@style/Afluente.PrimaryButton" android:id="@+id/btnContinuar" android:layout_width="0dp" android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="18dp" android:layout_marginBottom="30dp" android:text="@string/continue_label" app:layout_constraintTop_toBottomOf="@id/cardHabitosSustentaveis" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
